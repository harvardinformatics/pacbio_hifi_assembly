rule hifiasm:
    input:
        get_assem_input
    output:
        pasm = hifi_outdir + "/{sample}.p_ctg.gfa",
        hap1asm = hifi_outdir + "/{sample}.hap1.p_ctg.gfa",
        hap2asm = hifi_outdir + "/{sample}.hap2.p_ctg.gfa"
    conda:
        "envs/hifiasm.yaml"
    params:
        outdir = hifi_outdir + "/{sample}",
        assemOptions = get_assem_params,
        hasHic = checkHiC
    log:
        "logs/{sample}.hifiasm.out"
    shell: #The output naming format is slightly different in Hifiasm based if have HiC data; this logic deals with that by renaming output to a standard
        """
        mkdir -p $(dirname {log})
        hifiasm -t {threads} {params.assemOptions} -o {params.outdir} {input} &> {log}

        if [[ "{params.hasHic}" == "true" ]]; then
            mv {params.outdir}.hic.p_ctg.gfa {output.pasm}
            mv {params.outdir}.hic.hap1.p_ctg.gfa {output.hap1asm}
            mv {params.outdir}.hic.hap2.p_ctg.gfa {output.hap2asm}
        elif [[ "{params.hasHic}" == "false" ]]; then
            mv {params.outdir}.bp.p_ctg.gfa {output.pasm}
            mv {params.outdir}.bp.hap1.p_ctg.gfa {output.hap1asm}
            mv {params.outdir}.bp.hap2.p_ctg.gfa {output.hap2asm}
        fi
        """

rule gfa_to_fasta:
    input:
        hifi_outdir + "/{sample}.{haplo}.gfa"
    output:
        temp(hifi_outdir + "/{sample}.{haplo}.fa")
    shell:
        "awk '/^S/{{print \">\"$2;print $3}}' {input} > {output}"

rule rename_contig:
    input:
        hifi_outdir + "/{sample}.{haplo}.fa"
    output:
        assem_outdir + "/{sample}.{haplo}.fa"
    shell:
        "awk -v sample={wildcards.sample} -v haplo={wildcards.haplo} 'BEGIN{{FS=\">\"; OFS=\"#\"}} /^>/{{if (haplo ~ /hap/) print \">\"sample,haplo,$2; else print \">\"sample,\"pri\",$2}} !/^>/{{print;}}' {input} > {output}"

rule quast:
    input:
        assem_outdir + "/{sample}.{haplo}.fa"
    params:
        prefix="results/assembly_qc/{sample}.{haplo}.quast"
    output:
        "results/assembly_qc/{sample}.{haplo}.quast/report.txt"
    conda:
        "envs/quast.yaml"
    log:
        "logs/{sample}.{haplo}/quast_log"
    shell:
        """
        mkdir -p $(dirname {log})
        quast.py -t {threads} -o {params.prefix} {input} &> {log}
        """

rule meryl_count:
    input:
        get_assem_input
    output:
        db=directory("results/assembly_qc/{sample}.reads.k31.meryl")
    conda:
        "envs/merqury.yaml"
    params:
        k=31
    log:
        "logs/{sample}.meryl_count.out"
    shell:
        """
        mkdir -p $(dirname {log})
        meryl count k={params.k} output {output.db} {input} &> {log}
        """

rule merqury:
    input:
        db="results/assembly_qc/{sample}.reads.k31.meryl",
        asm=assem_outdir + "/{sample}.p_ctg.fa"
    output:
        directory("results/assembly_qc/{sample}.p_ctg.merqury")
    conda:
        "envs/merqury.yaml"
    params:
        prefix="merqury_{sample}.p_ctg"
    shell:
        """
        mkdir -p {output}
        merqury.sh {input.db} {input.asm} {params.prefix}
        mv merqury_* {output}
        """

#Add in compleasm/BUSCO for QC (default: eukaryota db)
rule busco:
    input:
        assem_outdir + "/{sample}.p_ctg.fa"
    output:
        "results/assembly_qc/{sample}.p_ctg.compleasm/summary.txt"
    conda:
        "envs/compleasm.yaml"
    log:
        "logs/{sample}_compleasm.out"
    params:
        lineage = get_lineage,
        prefix="results/assembly_qc/{sample}.p_ctg.compleasm"
    shell:
        """
        mkdir -p $(dirname {log})
        compleasm run -a {input} -o {params.prefix} -t {threads} {params.lineage} &> {log}
        """
