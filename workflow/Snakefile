from snakemake.exceptions import WorkflowError


#Config file
#configfile: "../config/config.yaml"

#Gets info from config file:
haplotypes=["p_ctg", "hap1.p_ctg", "hap2.p_ctg"]
valid_read_types = {"bam", "fastq"}


def normalize_read_list(value, sample, field_name):
    if isinstance(value, str):
        return [value]
    if isinstance(value, list) and value and all(isinstance(item, str) for item in value):
        return value
    raise WorkflowError(
        f'Sample "{sample}" field "{field_name}" must be a non-empty string or list of strings.'
    )


def validate_optional_string(sample, sample_info, field_name):
    if field_name in sample_info and not isinstance(sample_info[field_name], str):
        raise WorkflowError(
            f'Sample "{sample}" field "{field_name}" must be a string path.'
        )


def validate_config():
    if not isinstance(config.get("samples"), dict) or not config["samples"]:
        raise WorkflowError('Config must define a non-empty "samples" mapping.')

    for key in ("hifi_outdir", "assem_outdir", "intermediate_outdir"):
        if not isinstance(config.get(key), str) or not config[key]:
            raise WorkflowError(f'Config must define "{key}" as a non-empty string.')

    busco_cfg = config.get("busco", {})
    if busco_cfg is not None and not isinstance(busco_cfg, dict):
        raise WorkflowError('Config field "busco" must be a mapping when provided.')

    for sample, sample_info in config["samples"].items():
        if not isinstance(sample_info, dict):
            raise WorkflowError(f'Sample "{sample}" must map to a dictionary of settings.')

        has_hifi = "hifi" in sample_info
        has_nanopore = "nanopore" in sample_info
        if has_hifi == has_nanopore:
            raise WorkflowError(
                f'Sample "{sample}" must define exactly one of "hifi" or "nanopore".'
            )

        read_type = sample_info.get("readFileType")
        if read_type not in valid_read_types:
            raise WorkflowError(
                f'Sample "{sample}" must set readFileType to one of {sorted(valid_read_types)}.'
            )

        if has_hifi:
            normalize_read_list(sample_info["hifi"], sample, "hifi")
        if has_nanopore:
            normalize_read_list(sample_info["nanopore"], sample, "nanopore")

        has_hic1 = "hic1" in sample_info
        has_hic2 = "hic2" in sample_info
        if has_hic1 != has_hic2:
            raise WorkflowError(
                f'Sample "{sample}" must define both "hic1" and "hic2" or neither.'
            )

        validate_optional_string(sample, sample_info, "hic1")
        validate_optional_string(sample, sample_info, "hic2")
        validate_optional_string(sample, sample_info, "ultralong")

        lineage = busco_cfg.get(sample, "eukaryota")
        if not isinstance(lineage, str):
            raise WorkflowError(
                f'BUSCO lineage for sample "{sample}" must be a string or omitted.'
            )


validate_config()
samples = config["samples"]
hifi_outdir = config["hifi_outdir"]
assem_outdir = config["assem_outdir"]
inter_outdir = config["intermediate_outdir"]

# INPUT FUNCTIONS ######################################

#Input function to get reads
def get_reads(wildcards):
    sample_info = config["samples"][wildcards.sample]
    #if have hifi reads (i.e. have "hifi" key in config dict)
    if 'hifi' in sample_info:
        return normalize_read_list(sample_info["hifi"], wildcards.sample, "hifi")
    #if have ONT reads
    elif 'nanopore' in sample_info:
        return normalize_read_list(sample_info["nanopore"], wildcards.sample, "nanopore")
    raise WorkflowError(
        f'Sample "{wildcards.sample}" must define either "hifi" or "nanopore" reads.'
    )

#Fxn to get reads for hifiasm step, based on whether originally had BAM files or fastq files
def get_assem_input(wildcards):
    read_type = config["samples"][wildcards.sample]["readFileType"]
    if read_type == "bam":
        return f"{inter_outdir}/{wildcards.sample}_combined_reads.fromBam.fastq.gz"
    elif read_type == "fastq":
        return f"{inter_outdir}/{wildcards.sample}_combined_reads.fastq.gz"
    raise WorkflowError(
        f'Sample "{wildcards.sample}" has unsupported readFileType "{read_type}".'
    )

#Fxn to get assembly parameters for hifiasm step, based on available data
def get_assem_params(wildcards):
    samp = config["samples"][wildcards.sample]
    params = []
    # ONT assembly, need to add --ont flag
    if samp.get("nanopore"):
        params.append("--ont")
    # HiC data
    if samp.get("hic1"):
        params.append(f'--h1 {samp["hic1"]}')
    if samp.get("hic2"):
        params.append(f'--h2 {samp["hic2"]}')
    # Ultralong data
    if samp.get("ultralong"):
        params.append(f'--ul {samp["ultralong"]}')
    return " ".join(params)

#Fxn to handle different named output from hifiasm so can standardize naming
def checkHiC(wildcards):
    sample_info = config["samples"][wildcards.sample]
    #If have HiC reads
    if sample_info.get("hic1"):
        return "true"
    else:
        return "false"

def get_lineage(wildcards):
    lineage = config.get("busco", {}).get(wildcards.sample, "auto")
    if lineage == "auto":
        return "--autolineage"
    else:
        return f"-l {lineage}"

###########################################################

wildcard_constraints:
    haplo="p_ctg|hap1\\.p_ctg|hap2\\.p_ctg"

rule all:
    input:
        expand("results/assembly_qc/{sample}.{haplo}.quast/report.txt", haplo=haplotypes, sample=samples),
        expand("results/assembly_qc/{sample}.p_ctg.compleasm/summary.txt", sample=samples),
        expand("results/assembly_qc/{sample}.p_ctg.merqury", sample=samples)


#Used if reads in BAM format
rule bam2fastq:
    input:
        #Call input function; returns a list of files
        get_reads
    output:
        inter_outdir + "/{sample}_combined_reads.fromBam.fastq.gz"
    conda:
        "envs/bam2fastq.yaml"
    params:
        tmpdir = inter_outdir + "/{sample}_bam_fastq_tmp"
    shell:
        """
        mkdir -p $(dirname {output})
        rm -rf {params.tmpdir}
        mkdir -p {params.tmpdir}

        file_array=({input})
        for i in "${{!file_array[@]}}"; do
            samtools fastq "${{file_array[$i]}}" > {params.tmpdir}/part_${{i}}.fastq
        done

        cat {params.tmpdir}/part_*.fastq | gzip > {output}
        rm -rf {params.tmpdir}
        """

#Used if reads are in fastq format
rule combineFastq:
    input:
        #Call input function; returns a list of files
        get_reads
    output:
        inter_outdir + "/{sample}_combined_reads.fastq.gz"
    shell:
        """
        mkdir -p $(dirname {output})
        file_array=({input})
        if [[ "${{#file_array[@]}}" -eq 1 ]]; then
            cp "${{file_array[0]}}" {output}
        else
            zcat "${{file_array[@]}}" | gzip > {output}
        fi
        """

