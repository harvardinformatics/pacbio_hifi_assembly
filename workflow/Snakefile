import yaml
import glob, os, pathlib


#Config file
configfile: "../config/config.yaml"

#Gets info from config file:
samples = config["samples"]
haplotypes=["p_ctg", "hap1.p_ctg", "hap2.p_ctg"]
hifi_outdir = config["hifi_outdir"]
assem_outdir = config["assem_outdir"]
inter_outdir = config["intermediate_outdir"]

# INPUT FUNCTIONS ######################################

#Input function to get reads
def get_reads(wildcards):
    #if have hifi reads (i.e. have "hifi" key in config dict)
    if 'hifi' in config["samples"][wildcards.sample]:
        return config["samples"][wildcards.sample]["hifi"]
    #if have ONT reads
    elif 'nanopore' in config["samples"][wildcards.sample]:
        return config["samples"][wildcards.sample]["nanopore"]
   # return config["samples"][wildcards.sample]

#Fxn to get assembly parameters for assembly based on available data
def get_assem_params(wildcards):
    samp = config["samples"][wildcards.sample]
    #List of parameters to pass
    params = []
    #Hifi-only, don't need additional params
    #ONT assembly, need to add --ont flag:
    if 'nanopore' in samp:
        params.append("--ont")
    #HiC data:
    if 'hic1' in samp:
        params.append(f"--h1 {samp["hic1"]}")
    if 'hic2' in samp:
        params.append(f"--h2 {samp["hic2"]}")
    #Ultralong data:
    if 'ultralong' in samp:
        params.append(f"--ul {samp["ultralong"]}")   

    return " ".join(params)

#Fxn to handle different named output from hifiasm so can standardize naming
def checkHiC(wildcards):
    #If have HiC reads
    if config["samples"][wildcards.sample]["hic1"]:
        return f"true"
    else:
        return f"false"

###########################################################

rule all:
    input:
        expand("results/assembly_qc/{sample}.{haplo}.quast/report.txt", haplo=haplotypes, sample=samples)

#WIP: what do for ONT BAM vs fastq???
rule bam2fastq:
    input:
        #files = config["reads"].split(" ")
        #Call input function
        get_reads
    output:
        inter_outdir + "/{sample}_combined_reads.fastq.gz"
    conda:
        "envs/bam2fastq.yaml"
    params:
        prefix = inter_outdir + "/{sample}_combined_reads"
    shell:
        """
        file_array=({input})

        for file in "${{file_array[@]}}"; do
            pbindex $file
        done

        bam2fastq -o {params.prefix} {input}
        """

